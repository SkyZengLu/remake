{
  "name": "remake",
  "type": "module",
  "version": "3.0.0",
  "author": "Vick Scarlet <vick@syaro.io>",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "pnpm --filter @remake/web dev",
    "dev:prod": "pnpm --filter @remake/web dev:prod",
    "build:web": "pnpm --filter @remake/web build",
    "build:data": "pnpm --filter @remake/data build",
    "build:app": "pnpm build:data && pnpm build:web",
    "build:web-only": "pnpm build:web",
    "cap:add:android": "cap add android",
    "cap:sync": "pnpm build:web && cap sync android",
    "apk:debug": "cd android && gradlew.bat assembleDebug",
    "desktop:dev": "electron desktop/main.cjs",
    "build:exe": "pnpm build:web && electron-builder --config electron-builder.yml",
    "preview": "pnpm --filter @remake/web preview",
    "start": "pnpm --filter @remake/console start",
    "lint": "bunx --bun eslint",
    "lint:console": "pnpm --filter @remake/console lint",
    "lint:web": "pnpm --filter @remake/web lint",
    "lint:core": "pnpm --filter @remake/core lint",
    "lint:data": "pnpm --filter @remake/data lint",
    "lint:condition": "pnpm --filter @remake/condition lint",
    "lint:hooks": "pnpm --filter @remake/hooks lint",
    "fix": "bunx --bun eslint --fix",
    "fix:console": "pnpm --filter @remake/console lint --fix",
    "fix:web": "pnpm --filter @remake/web lint --fix",
    "fix:core": "pnpm --filter @remake/core lint --fix",
    "fix:data": "pnpm --filter @remake/data lint --fix",
    "fix:condition": "pnpm --filter @remake/condition lint --fix",
    "fix:hooks": "pnpm --filter @remake/hooks lint --fix",
    "test": "pnpm --filter @remake/web test",
    "test:console": "pnpm --filter @remake/console test",
    "test:web": "pnpm --filter @remake/web test",
    "test:core": "pnpm --filter @remake/core test",
    "test:data": "pnpm --filter @remake/data test",
    "test:condition": "pnpm --filter @remake/condition test",
    "test:hooks": "pnpm --filter @remake/hooks test"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@types/bun": "^1.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "thirdparty/*"
  ],
  "dependencies": {
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/share": "^7.0.4"
  }
}
